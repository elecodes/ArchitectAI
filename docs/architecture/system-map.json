{
  "version": "2.17.0",
  "meta": {
    "title": "ArchitectAI v1.6.0 Architecture System Map",
    "description": "Interactive Archify System Map for ArchitectAI v1.6.0 Architecture System Map",
    "preset": "signal-flow",
    "theme": "dark",
    "solidNotes": [
      "Single Responsibility Principle: Each agent has an explicit, single responsibility and Zod schema",
      "Open/Closed Principle: LLMProviderFactory allows adding new providers without mutating core agent logic",
      "Dependency Inversion Principle: High-level orchestrator depends on abstract AgentRunner infrastructure"
    ]
  },
  "nodes": [
    {
      "id": "expressapi",
      "label": "ExpressAPI",
      "role": "interface",
      "layer": "interface",
      "responsibilities": [
        "Expose REST API endpoints for generation, review, export, and telemetry",
        "Handle JWT Authentication and Rate Limiting",
        "Serve React frontend static assets"
      ]
    },
    {
      "id": "agentorchestrator",
      "label": "AgentOrchestrator",
      "role": "application",
      "layer": "application",
      "responsibilities": [
        "Coordinate execution of the 7 typed agents in sequential and parallel forks",
        "Manage workflow state, safe-stop gates, and execution graph"
      ]
    },
    {
      "id": "agentrunner",
      "label": "AgentRunner",
      "role": "application",
      "layer": "application",
      "responsibilities": [
        "Shared agent infrastructure: RAG context fitting, Zod validation, retry, timeout",
        "Capability whitelist enforcement (OWASP LLM06 Excessive Agency mitigation)"
      ]
    },
    {
      "id": "requirementsagent",
      "label": "RequirementsAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Generate functional requirements, constraints, assumptions, and acceptance criteria"
      ]
    },
    {
      "id": "architectureagent",
      "label": "ArchitectureAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Design system components, bounded contexts, layer responsibilities, and SOLID notes"
      ]
    },
    {
      "id": "securityagent",
      "label": "SecurityAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Perform threat modeling, OWASP LLM risk analysis, and security controls"
      ]
    },
    {
      "id": "cloudcostagent",
      "label": "CloudCostAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Produce cloud infrastructure topology, AWS/GCP resource choices, and cost safety estimates"
      ]
    },
    {
      "id": "devsecopsagent",
      "label": "DevSecOpsAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Define CI/CD pipelines, containerization specs, and deployment runbooks"
      ]
    },
    {
      "id": "qaagent",
      "label": "QAAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Formulate automated test plans, E2E scenarios, and test data requirements"
      ]
    },
    {
      "id": "synthesisagent",
      "label": "SynthesisAgent",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Aggregate outputs into a cohesive engineering package and generate Mermaid + Archify diagrams"
      ]
    },
    {
      "id": "archifyengine",
      "label": "ArchifyEngine",
      "role": "domain",
      "layer": "domain",
      "responsibilities": [
        "Transform ArchitectureDocument to Archify JSON IR and compile interactive HTML maps & diffs"
      ]
    },
    {
      "id": "llmproviderfactory",
      "label": "LLMProviderFactory",
      "role": "infrastructure",
      "layer": "infrastructure",
      "responsibilities": [
        "Provider abstraction for Google Gemini, OpenAI, Bedrock, Groq, OpenRouter, Ollama, Mock"
      ]
    },
    {
      "id": "documentstore",
      "label": "DocumentStore",
      "role": "infrastructure",
      "layer": "infrastructure",
      "responsibilities": [
        "Store generated artifacts on Local Filesystem or AWS S3"
      ]
    },
    {
      "id": "postgresdatabase",
      "label": "PostgresDatabase",
      "role": "database",
      "layer": "infrastructure",
      "responsibilities": [
        "Persist projects, generation telemetry, golden datasets, and pgvector embeddings"
      ]
    }
  ],
