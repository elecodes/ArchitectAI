# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (use "db" as host when running in Docker Compose, "localhost" for local dev)
DATABASE_URL=postgresql://architect:architect@db:5432/architectai

# Authentication
JWT_SECRET=  # REQUIRED - must be set explicitly

# LLM Provider (openrouter | openai | ollama | mock)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_CONTEXT_WINDOW=128000

# Embedding Provider (openai | openrouter | ollama | mock)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Ollama (only needed if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_GENERATION=10

# ---------------------------------------------------------------------------
# AWS (Sprint 7 — optional, all integrations off by default)
# ---------------------------------------------------------------------------

# LLM: AWS Bedrock provider (alternative to openrouter/openai/ollama/mock)
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_REGION=us-east-1
# BEDROCK_TIMEOUT_MS=60000
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# Storage: local filesystem (default) or S3
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=./data/storage
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=architectai
# S3_FORCE_PATH_STYLE=true  # path-style addressing (required for S3-compatible endpoints like LocalStack/MinIO)

# CloudWatch observability (default off; set to true to emit metrics)
# CLOUDWATCH_ENABLED=false
# CLOUDWATCH_REGION=
# CLOUDWATCH_METRICS_NAMESPACE=ArchitectAI

# AWS credentials are resolved via the SDK default credential provider chain
# (IAM roles in AWS; do NOT commit keys).
